#!/usr/bin/env python3
"""Fake `osascript` for itermon's hermetic test suite (see tests/README.md).

Placed at the front of PATH by tests/run_tests.py for the duration of the run,
so every `subprocess.run(["osascript", "-"], input=script, ...)` call inside
iterm_ctl.py hits this script instead of a real macOS `osascript` / iTerm2.

Contract with the real osascript this stands in for:
  - AppleScript source is piped on stdin.
  - Canned stdout is written back, matching the *shape* iterm_ctl.py expects
    from each of the three script shapes it ever generates.

It also logs every script it receives (one JSON object per line) to the file
named by $ITERMON_FAKE_LOG, if set, so tests can assert on the *generated*
AppleScript, not only on the parsed Python-side result.

Routing is by sniffing fixed substrings that only ever appear in the AppleScript
iterm_ctl.py's three generators (list_sessions / send_text / read_contents)
produce -- see iterm_ctl.py's list_sessions(), _for_session(), send_text(),
read_contents(). If none match, this exits non-zero with a clear stderr
message rather than guessing, so a drift in the generated AppleScript is loud.
"""
import json
import os
import sys


def _log(script: str) -> None:
    log_path = os.environ.get("ITERMON_FAKE_LOG")
    if not log_path:
        return
    with open(log_path, "a", encoding="utf-8") as f:
        f.write(json.dumps({"script": script}) + "\n")


def main() -> int:
    script = sys.stdin.read()
    _log(script)

    # send_text / read_contents both wrap their body in an `if (id of s) is
    # "<uuid>" then ... end if` lookup (see iterm_ctl._for_session).
    if "id of s) is" in script:
        if "write text" in script:
            # send_text: iterm_ctl.py discards the return value entirely.
            sys.stdout.write("")
            return 0
        if "return (contents of s)" in script:
            screen_path = os.environ.get("ITERMON_FAKE_SCREEN")
            if screen_path:
                with open(screen_path, encoding="utf-8") as f:
                    sys.stdout.write(f.read())
            else:
                sys.stdout.write("fake screen contents\n")
            return 0
        sys.stderr.write("fake osascript: unrecognized per-session body\n")
        return 1

    # list_sessions() is the only generator that walks windows/tabs/sessions
    # without an id lookup.
    if "repeat with w in windows" in script:
        listing_path = os.environ.get("ITERMON_FAKE_LISTING")
        if listing_path:
            with open(listing_path, encoding="utf-8") as f:
                sys.stdout.write(f.read())
        else:
            sys.stdout.write("")  # empty session list by default
        return 0

    sys.stderr.write("fake osascript: unrecognized script, refusing to guess\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
