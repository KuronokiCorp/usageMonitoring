#!/usr/bin/env python3
"""Fake `ps` for itermon's hermetic test suite (see tests/README.md).

iterm_ctl._annotate_jobs() runs `ps -t <tty> -o pid=,stat=,comm=` to find each
session's foreground job. This stand-in ignores its arguments (the real
command's exact flags aren't the seam under test -- the *rows it returns* are)
and instead prints back whatever canned "pid stat comm" text is named by
$ITERMON_FAKE_PS_OUTPUT, so a test can pick the exact rows it wants to feed
_annotate_jobs(). With that env var unset it prints nothing, i.e. "no matching
processes", which is what most tests want (job stays "").
"""
import os
import sys


def main() -> int:
    out_path = os.environ.get("ITERMON_FAKE_PS_OUTPUT")
    if out_path:
        with open(out_path, encoding="utf-8") as f:
            sys.stdout.write(f.read())
    return 0


if __name__ == "__main__":
    sys.exit(main())
